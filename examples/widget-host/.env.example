# The workspace widget secret. Get it as a teammate with quills:manage_settings:
#   GET  {instanceUrl}/api/quills/{workspace}/settings/widget/secret
#   POST the same path to create or rotate it.
# Server-only. Never prefix it with VITE_.
QUILLS_WIDGET_SECRET=

# Optional overrides. The defaults match `pnpm dev:demo`.
# VITE_QUILLS_INSTANCE_URL=http://127.0.0.1:1390
# VITE_QUILLS_WORKSPACE=quills_portal_demo
