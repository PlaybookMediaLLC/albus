{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Quills",
	"version": "0.1.0",
	"identifier": "io.playbookmedia.quills.desktop",
	"build": {
		"frontendDist": "../src"
	},
	"app": {
		"windows": [],
		"security": {
			"csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http: https:"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"category": "Productivity",
		"shortDescription": "Quills for desktop",
		"longDescription": "Quills feedback, roadmaps, support and projects in a desktop app.",
		"copyright": "Playbook Media LLC",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"macOS": {
			"minimumSystemVersion": "11.0"
		}
	}
}
